<!--  classifier_try.param     David Wallace BLACK     2017-04-  
~~Now classifier.param                                 2024-02-12  
~~
~~   This "<CustomClassificationParameters>" section is the one that will
~~   give all information necessary for the GUI. This includes information
~~	 for instruction, for setting up how the document to be classified will
~~	 be visualized, for setting up the actual classifications, any input
~~	 and output information necessary, and any other customizations to be
~~	 made to the GUI.
~~	 There should be only one "<CustomClassificationParameters>" field.
~~	 
~~	 Inside of it should be 1 of each of the following
~~	   <Info4Gui>
~~	   <Info4IO>
~~	 
~~	 and 0 or more
~~	   <ClassificationGroup>
-->
<CustomClassificationParameters>
  
  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
       This "<Info4Gui>" section will give the information about things 
       that will allow customization of the GUI - such things as 
	   instructions, presentation of the document(s) to be classified, 
	   and some visual aspects of the presentation of the possible
       classifications.
	   There should be:
	   
	     1 <Instructions>
	    
		 1 or 2      <InputPanel>
		   These can be created with any of the following 
		   <InputPanelType> :
		     "static-image"      (scrollable)
			 "zoomable-image"    (scrollable)
			 "text-field"        (scrollable, not editable)
			 "formatted-text"    (scrollable, e.g. html output)
			 !! Maybe later:
			 !! "zoomable-zoned-image"
			 !! "purplized-image"
			 !! "entity-tagger-output"
			 !! "relation-tagger-output"
			 !! "text-field-editable"
		 
		 0 or more   <SelectionPanel>
		   If there are no <SelectionPanel>, only the comment field
		   will be shown.
		   These can be created with any of the following
		   <SelectionPanelType> :
		     "radio-buttons"         ("round select" buttons, only one
			                          can be selected at a time.)
			 "drop-down-menu"        (useful when there are many, many
			                          classifications. only one can
									  be selected at a time)
			 "checkboxes"            (more than one can be selected
			                          at the same time)
			 "text-input"             (where each needs to be typed)
       
       
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <Info4Gui>
    <!-- For now, this is not read, but will, in the future, -->
	  <!-- allow customization of the GUI for different input. -->
	  <!-- Now, we'll just use JRadioButtons                   -->
    
	  <!-- Give instructions for how to select. Depending on the
	       decided scope of this classifier, this might never
		     change. There should not be more than two lines, and
		     the text should not go further than 
      |~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|  
	                                                         -->
	  <Instructions>
	    On your keyboard, press the letter in parentheses
	    next to the best descritpion of the document.
	  </Instructions>
	
	  <!-- These will be inserted horizontally, with the first  
         panel at the left.                                  -->
	  <!-- For input images, the possible file extensions are:
	     
		   If nothing is listed in the "<ImageExtensions>", or
		   the tag is blank, all extensions will be allowed.    -->
    <!-- For input images, the possible file extensions are:
	     
		   If nothing is listed in the "<ImageExtensions>", all
		   extensions will be allowed.                         -->
    <!-- For input text, for now, the possible file 
	       extensions are:
		     .txt
		   Pat will likely have other extensions which can be
		   used for input text (I'm thinking about the text-
		   tiling ".param" files                               -->
    
  	<InputPanel id="n0">
	    <InputPanelType>"zoomable-image"</InputPanelType>
	    <ImageExtensions>jpg</ImageExtensions> <!-- space-delimit -->
	    <Title>"Paper FHTC 2024: Types of Reuse"</Title>
	  
  	</InputPanel>
	
	  <!-- Stacked Vertically -->
	  <SelectionPanel id="s0" class="radio-buttons">
	    <SelectionPanelType>radio-buttons</SelectionPanelType>
	    <RelevantGroups>"g0"</RelevantGroups> <!-- space-delimit -->
	  </SelectionPanel>
    
  </Info4Gui>
  
  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
       This "<Info4IO>" section will 
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <InfoForIO>
    
    <!-- If no "<DefaultInputDirectory>" tag exists, if the 
	     directory doesn't exist, or if the tag is empty,
	     the directory from which the classifier is run 
		   will become the default directory.             -->
    <DefaultInputDirectory>
      <!--WindowsInPath>C:\Users\bball\Desktop\cropped_document_images_skinny\holder\input\</WindowsInPath-->
	    <WindowsInPath>C:\David\FHTW-2025-All_-_move_2024_get_new\Classification_Folder\input\</WindowsInPath>
	    <LinuxInPath>"/mnt/c/David/FHTW-2025-All_-_move_2024_get_new/Classification_Folder/input/"</LinuxInPath>
	    <MacOSInPath>"/mnt/c/David/FHTW-2025-All_-_move_2024_get_new/Classification_Folder/input/"</MacOSInPath>
	    
	    <DoRandomizeInputFiles>false</DoRandomizeInputFiles>
      
      <DoIncludeFilenameEnding>false</DoIncludeFilenameEnding>
	    
	  </DefaultInputDirectory>
	
	
	  <!-- If no "<DefaultOutputDirectory>" tag exists, if 
	       the directory doesn't exist, or if the tag is
	       empty, the directory from which the classifier is 
		     run will become the default directory.         -->
	  <DefaultOutputDirectory>
      <!--WindowsOutPath>C:\Users\bball\Desktop\cropped_document_images_skinny\holder\output\</WindowsOutPath-->
	    <WindowsOutPath>C:\David\FHTW-2025-All_-_move_2024_get_new\Classification_Folder\output\</WindowsOutPath>
	    <LinuxOutPath>"/mnt/c/David/FHTW-2025-All_-_move_2024_get_new/Classification_Folder/output/"</LinuxOutPath>
	    <MacOSOutPath>"/mnt/c/David/FHTW-2025-All_-_move_2024_get_new/Classification_Folder/output/"</MacOSOutPath>
	  
	  </DefaultOutputDirectory>
	
  </InfoForIO>
  
  
  <!-- Classification convention, clarified 2026-11-08, current RMMFB MVP:
       This explains an earlier locked procedure; it changes no rule and
       does not date the original lock. See ONTOLOGY_PROVENANCE.md.
       Classify visible reuse by its binding context and exposure. Regions
       of the same original writing surface can receive different subtype
       tags. Apply mbr under the existing guide-specific exceptions, not by
       counting all tags: UCR/SPR alternatives for one uncertain piece do
       not alone warrant mbr, and abg is not an additional reuse subtype.
       Wrapper captions still need author reconciliation; see the guide
       consistency review. This comment does not resolve that ambiguity.
       A turned-over cover corner exposing earlier information on
       its underside counts as ucr without requiring a tear. Earlier
       information visible through the exterior cover counts as orc; the
       analogous front/back-matter case counts as fmr within that scope.
       Use spr for the spine-protection context defined in the guide.
       Several classes do not imply several independent source fragments.
       See CLASSIFICATION_CONTEXT_ADDENDUM.md for the dated study convention.
       Later ontology revisions must be recorded separately; no automatic
       rewriting of historical filenames or classifications is implied.
  -->


  <!-- Description consolidation, recorded 2026-11-17:
       classifier.param contains the maintained class definitions and settings.
       Non-conflicting legacy HTML explanations and accepted later instructions
       are consolidated here; shorter guides are synchronized references.
       Explicit author decisions take precedence over stale historical prose.
       See docs/ONTOLOGY_DESCRIPTION_CONSOLIDATION_2026-11-17.md for the source
       mapping, conflict dispositions, exact HTML backup, and remaining work.
       This records new clarifications without assigning a new freeze date.
       No historical image name or dataset annotation is changed by this file.
  -->

  <ClassificationGroup id="g0">
  
  <!-- Phrase to remember: "image specifically meant to show the [specific] surface" -->
    
	  <!-- This next, "choose one" button should always be put in. -->
	  <Classification id="c0">
      <DisplayName>Or click type btn and submit</DisplayName>
      <DirectoryName></DirectoryName>
      <KeyboardShortcut></KeyboardShortcut>
	    <AddedFilenameEnding></AddedFilenameEnding>
	    <Description>
	      Select this button to clear the selection.
	    </Description>
      <Examples>
        
      </Examples>
      
    </Classification> <!-- ENDOF:  id="c0"             ~~
                        ~~ JUST DON'T REMOVE THIS ONE  ~~
                        ~~ ~~~~~~~~~~~~~~~~~~~~~~~~~~  -->
	  
	  
    <Classification id="c1">
      <DisplayName>Outside cover reuse</DisplayName>
	    <KeyboardShortcut>O</KeyboardShortcut>
	    <DirectoryName>Outside_Cover_Reuse</DirectoryName>
	    <AddedFilenameEnding>orc</AddedFilenameEnding>
	    <Description>
        Information from an earlier use is visible on or through the exterior
        front cover, back cover, or covering material over the spine. The
        cover must still be on the book. For detached material use the current
        general-not-in-situ class, c15 (J, gni), rather than the former
        separate not-in-situ-cover key.

        ORC applies when information on the opposite side of the same cover
        material is visible through the exterior surface. It still applies
        when that opposite side is functionally front/back matter. That FMR
        function does not replace ORC in the exterior view. Translucence alone
        does not create UCR. Other independently applicable classes may
        coexist.

        Writing added for the present binding, such as its title or catalogue
        annotation, does not by itself establish reuse. Wear and orientation
        do not prove chronology. Record uncertain or case-specific annotation
        judgments without asserting a historical sequence that is not known.
      </Description>
	    <Examples>
        In other file
	    </Examples>
      
    </Classification> <!-- ENDOF:  id="c1"             ~~
                        ~~ Outside cover reuse         ~~
                        ~~ ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	
	  <Classification id="c2">
      <DisplayName>undeR cover reuse</DisplayName>
	    <KeyboardShortcut>R</KeyboardShortcut>
	    <DirectoryName>Under_Cover_Reuse</DirectoryName>
	    <AddedFilenameEnding>ucr</AddedFilenameEnding>
	    <Description>
        Reused information is exposed beneath a front or back cover, or
        beneath front/back matter such as a paste-down. A tear, hole, missing
        portion, undersized cover, or folded-back/turned-over portion can
        expose it. A separate fragment is not required. Translucence alone is
        not UCR. If exterior-cover reuse is also visible, ORC and UCR can
        coexist.

        Use SPR when the visible material is identifiable as spine protection
        in the specified SPR context. For broken book gutters use UCR unless
        SPR is apparent. Existing instructions allow uncertain UCR/SPR
        alternatives for one piece without MBR; another qualifying reuse
        instance can warrant MBR under the normal multiple-class rules.

        Retain the documented over-cover case: a torn or remaining piece from
        another surface, visibly distinct from the main reuse, can qualify as
        UCR. When the only reuse in that over-cover-remnant situation occupies
        a front-matter surface, use FMR instead. This specific exception is
        not a blanket ban on UCR and FMR sharing a region.

        Clarification recorded 2026-11-17: where a slit, tear, or fold exposes
        information on material identified as FMR, UCR and FMR may describe
        the same visible region. Retain both labels in a multilabel regional
        annotation. If a single label must be chosen for that exposed region,
        prefer UCR. Do not infer FMR solely from the existence of an opening.
        This does not turn uncertainty between alternative classes into two
        confirmed classes or supersede other specific MBR exceptions.
      </Description>
	    <Examples>
        In other file
	    </Examples>
      
    </Classification> <!-- ENDOF:  id="c2"             ~~
                        ~~ unDer cover reuse           ~~
                        ~~ ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	
	  <Classification id="c3">
      <DisplayName>sPine protection reuse</DisplayName>
	    <KeyboardShortcut>P</KeyboardShortcut>
	    <DirectoryName>Spine_Protection_Reuse</DirectoryName>
	    <AddedFilenameEnding>spr</AddedFilenameEnding>
	    <Description>
        Reused information is visible on material protecting the spine,
        including the folds of the gatherings, where the spine covering is
        absent or displaced. The protective material may extend toward the
        covers. An image containing a spine does not by itself establish SPR.

        If the material is seen as part of a paste-down or flyleaf, use FMR
        unless the image is specifically intended to show the spine. For
        uncertain UCR/SPR alternatives retain the UCR instructions and the
        existing exception to MBR. The legacy HTML's absolute prohibition on
        SPR at gutter tears is superseded by the later documented rule
        allowing SPR when spine protection is apparent.

        Multiple classifications are permitted. In the legacy single-choice
        situation, also-visible exterior-cover reuse takes ORC precedence
        unless the view is specifically meant to show the spine.
      </Description>
	    <Examples>
        In other file
	    </Examples>
      
    </Classification> <!-- ENDOF:  id="c3"             ~~
                        ~~ sPine protection reuse      ~~
                        ~~ ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	  
    <Classification id="c4">
      <DisplayName>Front-back matter reuse</DisplayName>
	    <KeyboardShortcut>F</KeyboardShortcut>
	    <DirectoryName>Front-back_Matter_Reuse</DirectoryName>
	    <AddedFilenameEnding>fmr</AddedFilenameEnding>
	    <Description>
        Information from a previous use appears on a paste-down or flyleaf. A
        paste-down may still be attached, partly detached, or fully detached
        while remaining among the front/back leaves. Multiple flyleaves can
        qualify; the classification does not distinguish paste-down from
        flyleaf. The information may be directly visible or visible through
        the material from its opposite side.

        The inside of a limp cover can qualify when it occupies the
        structurally equivalent position of a paste-down. The legacy Bamberg
        HVMsc359 image 00003 example explicitly establishes this inner-cover
        case.

        Material containing only the current book's own text, title,
        description, cataloguing, or pen trials does not qualify on that basis
        alone. Reused text, decoration, or illumination must be present.

        In an exterior-cover view, information visible through the cover still
        requires ORC even when its opposite-side location is functionally FMR.
        For FMR information physically exposed by a slit, tear, or fold, the
        November 17 clarification permits FMR and UCR on the same visible
        region, with UCR taking precedence if only one label is available. See
        c2 for the separate over-cover-remnant exception.
      </Description>
	    <Examples>
        In other file
	    </Examples>
      
    </Classification> <!-- ENDOF:  id="c4"             ~~
                        ~~ Front-back matter reuse     ~~
                        ~~ ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    
